# SECOND BRAIN 404 v2.3.0
BRAIN_HOST_PATH=./brain

# Chat / embeddings
CHAT_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=all-minilm

# Optional cloud chat providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Retrieval Intelligence v2.3
RAG_TOP_K=6
RAG_CANDIDATE_POOL=50
RAG_RRF_K=60
RAG_RERANKER=local
RAG_RERANK_WEIGHT=0.24
RAG_MMR_LAMBDA=0.72
RAG_MIN_SCORE=0.08
RAG_MAX_PER_DOCUMENT=2

# Structural chunking
CHUNK_SIZE=1400
CHUNK_OVERLAP=220

# Index / watcher
INDEX_DIRS=00_RAW,10_WIKI,20_PROJECTS,40_MEMORY
AUTO_INDEX=true
WATCH_INTERVAL_SECONDS=15
AUTO_MEMORY_SUGGESTIONS=true
MAX_UPLOAD_MB=50
